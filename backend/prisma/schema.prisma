generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PM
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_MOVED_TO_REVIEW
  TASK_OVERDUE
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role
  createdAt     DateTime @default(now())

  // A PM manages projects they created
  projectsManaged   Project[]        @relation("PMProjects")
  // A Developer is assigned tasks
  tasksAssigned     Task[]           @relation("AssignedTasks")
  activityLogs      ActivityLog[] @relation("ActorLogs")
  notifications     Notification[]

  @@index([role])
}

model Client {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  pmId        String
  pm          User     @relation("PMProjects", fields: [pmId], references: [id])
  createdAt   DateTime @default(now())

  tasks         Task[]
  activityLogs  ActivityLog[]

  // PMs frequently query "my projects" -> index on pmId
  @@index([pmId])
  @@index([clientId])
}

model Task {
  id             String     @id @default(uuid())
  number         Int        @unique @default(autoincrement())
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  assignedToId   String?
  assignedTo     User?      @relation("AssignedTasks", fields: [assignedToId], references: [id])
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  dueDate        DateTime?
  isOverdue      Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  activityLogs   ActivityLog[]
  notifications  Notification[]

  // Frequently queried/filtered columns get indexes:
  // - projectId: every task list is scoped to a project
  // - assignedToId: developer dashboards filter "my tasks"
  // - status/priority: dashboard aggregation + filter query params
  // - dueDate: overdue cron sweep + "due this week" queries
  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([projectId, status])
}

model ActivityLog {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User     @relation("ActorLogs", fields: [actorId], references: [id])
  fromStatus TaskStatus?
  toStatus   TaskStatus
  message    String
  createdAt  DateTime @default(now())

  // The activity feed is queried by project (PM/Admin) and needs
  // reverse-chronological pagination -> composite index.
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  taskId    String?
  task      Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())

  // Notification bell always queries "my unread notifications, newest first"
  @@index([userId, isRead])
  @@index([userId, createdAt])
}
